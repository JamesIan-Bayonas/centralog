                <td style={{ padding: '14px', textAlign: 'right', fontFamily: 'monospace', color: 'var(--clr-success)', fontWeight: 600 }}>₱{row.currentBookValue.toLocaleString(undefined, { minimumFractionDigits: 2 })}</td>
