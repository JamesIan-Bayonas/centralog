    display: none !important;
  }

  .app-workspace {
    padding: 0 !important;
    margin: 0 !important;
    gap: 0 !important;
  }

  /* Structural Document Header generation exclusively for the printed paper context */
  .app-workspace::before {
    content: "CENTRALOG HARDWARE RESOURCE CAPITAL LEDGER\A STATUS VERIFICATION REPORT FOR AUDIT PURPOSES\A GENERATED: SYSTEM AUTOMATION WORKFLOW";
    display: block;
