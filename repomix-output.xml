@import url('https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;700&family=Inter:wght@300;400;500;600;700&display=swap');

:root {
  --font-main: 'Inter', -apple-system, sans-serif;
  --font-mono: 'JetBrains Mono', monospace;
  --clr-success: #10b981;
  --clr-warning: #f59e0b;
  --clr-danger: #ef4444;
}

/* THEME: OBSIDIAN CORE */
.theme-obsidian {
  --canvas: #06070a;
  --surface: #0d0f14;
  --surface-raised: #161922;
  --border: #242936;
  --text-primary: #f8fafc;
  --text-muted: #64748b;
  --accent: #3b82f6;
  --row-hover: rgba(59, 130, 246, 0.05);
}

/* THEME: LIGHT LEDGER */
.theme-light {
  --canvas: #f1f5f9;
  --surface: #ffffff;
  --surface-raised: #f8fafc;
  --border: #e2e8f0;
  --text-primary: #0f172a;
  --text-muted: #94a3b8;
  --accent: #2563eb;
  --row-hover: rgba(15, 23, 42, 0.03);
}

/* THEME: DMC MATRIX */
.theme-dmc {
  --canvas: #f4f7f5;
  --surface: #ffffff;
  --surface-raised: #ecfdf5;
  --border: #cbd5e1;
  --text-primary: #064e3b;
  --text-muted: #475569;
  --accent: #059669;
  --row-hover: rgba(16, 185, 129, 0.08);
}

body { margin: 0; font-family: var(--font-main); transition: background 0.3s; }

.app-viewport {
  background-color: var(--canvas);
  color: var(--text-primary);
  min-height: 100vh;
  display: flex;
  flex-direction: column;
}

/* UC-06: ANIMATED ALERT ROW */
@keyframes row-pulse {
  0% { background-color: rgba(245, 158, 11, 0.03); box-shadow: inset 4px 0 0 var(--clr-warning); }
  50% { background-color: rgba(245, 158, 11, 0.09); box-shadow: inset 8px 0 0 var(--clr-warning); }
  100% { background-color: rgba(245, 158, 11, 0.03); box-shadow: inset 4px 0 0 var(--clr-warning); }
}
.row-maintenance { animation: row-pulse 2s infinite ease-in-out; }

/* SHARED TABLE STYLES */
.ledger-table { width: 100%; border-collapse: collapse; font-size: 13px; }
.ledger-table th { 
  background-color: var(--surface-raised); 
  color: var(--text-muted); 
  padding: 12px 16px; 
  text-align: left; 
  border-bottom: 1px solid var(--border);
  text-transform: uppercase; font-size: 10px; letter-spacing: 1px;
}

/* DMC THEME SPECIFIC TABLE HEADER CONTRAST FIX */
.theme-dmc .ledger-table th { 
  background-color: #064e3b; 
  color: #ffffff; 
  border-bottom: 1px solid #043e2e;
}

.theme-dmc .ledger-table th svg {
  color: #a7f3d0; /* High contrast mint accent for header icons */
}

.ledger-table td { padding: 12px 16px; border-bottom: 1px solid var(--border); }
.mono { font-family: var(--font-mono); font-variant-numeric: tabular-nums; }
